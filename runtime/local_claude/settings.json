{
  "env": {
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "model": "sonnet[1m]",
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "macos-use": {
      "command": "/Users/localserver99/local_code/server/scripts/macos-use-global.sh"
    },
    "websearch": {
      "command": "/Users/localserver99/local_code/local-search/mcp-websearch/.venv/bin/python",
      "args": [
        "/Users/localserver99/local_code/local-search/mcp-websearch/server.py"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/localserver99/local_code/model-gateway/runtime/local_claude/block-cloud-tools.sh"
          }
        ]
      }
    ]
  }
}
