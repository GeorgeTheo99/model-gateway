<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.claude-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/localserver99/.local/bin/omlx</string>
        <string>serve</string>
        <string>--model-dir</string>
        <string>/Users/localserver99/models/mlx</string>
        <string>--port</string>
        <string>9110</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--paged-ssd-cache-dir</string>
        <string>/Users/localserver99/.omlx/cache</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/localserver99/local_code/model-gateway/runtime/omlx-config</string>
