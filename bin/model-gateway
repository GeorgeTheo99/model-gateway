#!/usr/bin/env bash
# model-gateway — portable macOS launchd operator CLI.
#
# Self-contained installer/control surface for consumer machines that run this
# repo directly (git clone + install), without the maintainer's CI-managed dev-server deployment
# infrastructure.
#
# Usage:
#   model-gateway install [--no-start] [--force]  bootstrap venv + plist + start + verify
#   model-gateway uninstall                      stop service, remove plist (keeps repo/venv)
#   model-gateway start | stop | restart
#   model-gateway status                         launchd state + /health probe
#   model-gateway verify                         /health smoke check
#   model-gateway logs [-f|lines]                tail service log
#   model-gateway update                         git pull + uv sync + restart + verify
#   model-gateway onboard PROFILE [options]      apply a reviewed onboarding profile
#   model-gateway onboard generate [options]     discover metadata and save a draft profile
#   model-gateway workspace COMMAND [options]    manage Databricks workspace pools
#   model-gateway env                            print resolved config
set -euo pipefail
umask 077

# --------------------------------------------------------------------------- #
# Config resolution.
# --------------------------------------------------------------------------- #
SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE_PATH")"
  case "$LINK_TARGET" in
    /*) SOURCE_PATH="$LINK_TARGET" ;;
    *) SOURCE_PATH="$SOURCE_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

LABEL="${MODEL_GATEWAY_LAUNCHD_LABEL:-com.local.model-gateway}"
PLIST_DIR="${MODEL_GATEWAY_PLIST_DIR:-$HOME/Library/LaunchAgents}"
LOG_DIR="${MODEL_GATEWAY_LOG_DIR:-$HOME/Library/Logs/model-gateway}"
LOG_FILE="${MODEL_GATEWAY_LOG_FILE:-$LOG_DIR/model-gateway.log}"
BACKUP_DIR="${MODEL_GATEWAY_BACKUP_DIR:-$HOME/Library/Application Support/model-gateway/backups/config}"
LEGACY_BACKUP_DIRS="${MODEL_GATEWAY_LEGACY_BACKUP_DIRS:-$LOG_DIR/config-backups}"
BIN_DIR="${MODEL_GATEWAY_BIN_DIR:-$HOME/.local/bin}"
FORCE="${MODEL_GATEWAY_FORCE:-0}"
INSTALL_CONFIG="$HOME/Library/Application Support/model-gateway/install.env"

installed_config_value() {
  local metadata
  [ -f "$INSTALL_CONFIG" ] && [ ! -L "$INSTALL_CONFIG" ] || return 0
  metadata="$(stat -f '%u %l %Lp' "$INSTALL_CONFIG" 2>/dev/null || stat -c '%u %h %a' "$INSTALL_CONFIG" 2>/dev/null || true)"
  [ "$metadata" = "$(id -u) 1 600" ] || return 0
  awk -v prefix="$1=" 'index($0, prefix) == 1 {print substr($0, length(prefix) + 1); exit}' \
    "$INSTALL_CONFIG"
}

installed_plist_env() {
  local plist="$PLIST_DIR/$LABEL.plist"
  [ -f "$plist" ] && [ ! -L "$plist" ] && [ -x /usr/libexec/PlistBuddy ] || return 0
  /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$1" "$plist" 2>/dev/null || true
}

INSTALLED_HOST="$(installed_config_value MODEL_GATEWAY_HOST)"
INSTALLED_HOST="${INSTALLED_HOST:-$(installed_plist_env MODEL_GATEWAY_HOST)}"
INSTALLED_PORT="$(installed_config_value MODEL_GATEWAY_PORT)"
INSTALLED_PORT="${INSTALLED_PORT:-$(installed_plist_env MODEL_GATEWAY_PORT)}"
HOST="${MODEL_GATEWAY_HOST:-${INSTALLED_HOST:-127.0.0.1}}"
PORT="${MODEL_GATEWAY_PORT:-${INSTALLED_PORT:-9111}}"
CONFIG_PATH="${MODEL_GATEWAY_CONFIG:-$ROOT_DIR/config/config.yaml}"
MODEL_INFO_PATH="${MODEL_GATEWAY_MODEL_INFO:-$ROOT_DIR/model-info.json}"
ACTIVE_MODEL_INFO_SOURCE=""
if [ -f "$PLIST_DIR/$LABEL.plist" ] && [ -x /usr/libexec/PlistBuddy ]; then
  ACTIVE_MODEL_INFO_SOURCE="$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:MODEL_GATEWAY_MODEL_INFO_SOURCE' "$PLIST_DIR/$LABEL.plist" 2>/dev/null || true)"
fi
MODEL_INFO_SOURCE_PATH="${MODEL_GATEWAY_MODEL_INFO_SOURCE:-${ACTIVE_MODEL_INFO_SOURCE:-$ROOT_DIR/model-info.json}}"
LEDGER_PATH="${MODEL_GATEWAY_LEDGER_PATH:-$HOME/srv/model-gateway/shared/ledger.db}"
if [ "${GATEWAY_VISION_FALLBACK+x}" = x ]; then
  VISION_FALLBACK="$GATEWAY_VISION_FALLBACK"
else
  VISION_FALLBACK="$(installed_plist_env GATEWAY_VISION_FALLBACK)"
fi
if [ "${GATEWAY_VISION_FALLBACK_LOCAL+x}" = x ]; then
  VISION_FALLBACK_LOCAL="$GATEWAY_VISION_FALLBACK_LOCAL"
else
  VISION_FALLBACK_LOCAL="$(installed_plist_env GATEWAY_VISION_FALLBACK_LOCAL)"
fi
if [ "${GATEWAY_VISION_FALLBACK_CLOUD+x}" = x ]; then
  VISION_FALLBACK_CLOUD="$GATEWAY_VISION_FALLBACK_CLOUD"
else
  VISION_FALLBACK_CLOUD="$(installed_plist_env GATEWAY_VISION_FALLBACK_CLOUD)"
fi
if [ "${GATEWAY_VISION_FALLBACK_MODE+x}" = x ]; then
  VISION_FALLBACK_MODE="$GATEWAY_VISION_FALLBACK_MODE"
else
  VISION_FALLBACK_MODE="$(installed_plist_env GATEWAY_VISION_FALLBACK_MODE)"
fi
if [ "${GATEWAY_VISION_FALLBACK_MAX_IMAGES+x}" = x ]; then
  VISION_FALLBACK_MAX_IMAGES="$GATEWAY_VISION_FALLBACK_MAX_IMAGES"
else
  VISION_FALLBACK_MAX_IMAGES="$(installed_plist_env GATEWAY_VISION_FALLBACK_MAX_IMAGES)"
fi
if [ "${GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS+x}" = x ]; then
  VISION_OBSERVATION_CACHE_TTL_SECONDS="$GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS"
else
  VISION_OBSERVATION_CACHE_TTL_SECONDS="$(installed_plist_env GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS)"
fi
if [ "${GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS+x}" = x ]; then
  VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS="$GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS"
else
  VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS="$(installed_plist_env GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS)"
fi
UV_BIN="${UV_BIN:-$(command -v uv 2>/dev/null || true)}"

# Colors (disabled when not a TTY).
if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'
else
  C_RESET=""; C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""
fi

log()  { printf '%s▶%s %s\n' "$C_BOLD" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

require_cmd() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1 (install it and retry)"; }

ensure_private_dir() {
  local path="$1"
  [ ! -L "$path" ] || die "refusing symlinked private directory: $path"
  mkdir -p "$path"
  [ -d "$path" ] && [ ! -L "$path" ] || die "private path is not a directory: $path"
  [ "$(stat -f '%u' "$path")" = "$(id -u)" ] || die "private directory is not owned by this user: $path"
  chmod 700 "$path"
}

ensure_private_file() {
  local path="$1" metadata
  if [ -e "$path" ] || [ -L "$path" ]; then
    [ -f "$path" ] && [ ! -L "$path" ] || die "refusing unsafe private file: $path"
    metadata="$(stat -f '%u %l' "$path")"
    [ "$metadata" = "$(id -u) 1" ] || die "private file has unsafe ownership or hard links: $path"
  else
    : > "$path"
  fi
  chmod 600 "$path"
}

validate_bind_config() {
  case "$HOST" in ''|*[[:space:]]*) die "MODEL_GATEWAY_HOST must be a nonempty host without whitespace" ;; esac
  case "$PORT" in ''|*[!0-9]*) die "MODEL_GATEWAY_PORT must be an integer between 1 and 65535" ;; esac
  if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    die "MODEL_GATEWAY_PORT must be an integer between 1 and 65535"
  fi
}

persist_install_config() {
  validate_bind_config
  ensure_private_dir "$(dirname "$INSTALL_CONFIG")"
  local tmp metadata
  if [ -e "$INSTALL_CONFIG" ] || [ -L "$INSTALL_CONFIG" ]; then
    [ -f "$INSTALL_CONFIG" ] && [ ! -L "$INSTALL_CONFIG" ] \
      || die "refusing unsafe private file: $INSTALL_CONFIG"
    metadata="$(stat -f '%u %l' "$INSTALL_CONFIG" 2>/dev/null || stat -c '%u %h' "$INSTALL_CONFIG")"
    [ "$metadata" = "$(id -u) 1" ] \
      || die "private file has unsafe ownership or hard links: $INSTALL_CONFIG"
  fi
  tmp="$(mktemp "$(dirname "$INSTALL_CONFIG")/.install.env.XXXXXX")"
  chmod 600 "$tmp"
  printf 'MODEL_GATEWAY_HOST=%s\nMODEL_GATEWAY_PORT=%s\n' "$HOST" "$PORT" >"$tmp"
  mv -f "$tmp" "$INSTALL_CONFIG"
  chmod 600 "$INSTALL_CONFIG"
}

check_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "model-gateway installer currently supports macOS launchd only"
}

check_prereqs() {
  check_macos
  require_cmd git
  require_cmd curl
  require_cmd python3
  require_cmd uv
  require_cmd launchctl
  UV_BIN="${UV_BIN:-$(command -v uv)}"
  [ -n "$UV_BIN" ] || die "uv not found"
}

# --------------------------------------------------------------------------- #
# Bootstrap.
# --------------------------------------------------------------------------- #
ensure_config() {
  if [ -f "$CONFIG_PATH" ]; then
    log "Config exists: $CONFIG_PATH"
    local real_config mode
    real_config="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$CONFIG_PATH")"
    mode="$(stat -f '%Lp' "$real_config" 2>/dev/null || stat -c '%a' "$real_config" 2>/dev/null || echo '')"
    if [ -n "$mode" ] && [ "$mode" != "600" ]; then
      chmod 600 "$real_config"
      warn "Tightened config permissions to 0600 (was $mode): $real_config"
    fi
    return 0
  fi
  mkdir -p "$(dirname "$CONFIG_PATH")"
  ( umask 077; : >"$CONFIG_PATH" )
  cat >"$CONFIG_PATH" <<EOF
# model-gateway runtime config.
# Created by bin/model-gateway install. See config/config.yaml.example for the
# full provider/auth/export template. Add provider secrets here; this file is
# gitignored and should never be committed.

auth:
  # admin_keys protects /admin/api/*. Add a real key before using admin APIs.
  admin_keys: []
  # client_keys protects /v1/*. Leave empty only when MODEL_GATEWAY_HOST is
  # loopback/private; add keys for any externally reachable gateway.
  client_keys: []

providers: {}

# Optional downstream alias export consumed by pi-shared/bin/pi-catalog:
# exports:
#   model_aliases: ~/srv/model-gateway/shared/model-aliases.json
EOF
  chmod 600 "$CONFIG_PATH"
  warn "Created empty config at $CONFIG_PATH; add provider secrets/auth before expecting models to route"
}

ensure_model_catalog() {
  if [ ! -f "$MODEL_INFO_PATH" ]; then
    # Fresh install: create a starter catalog so first run works out of the
    # box. The placeholder routes nowhere (its provider is unconfigured) and
    # is replaced by the first real 'model-gateway onboard' apply.
    mkdir -p "$(dirname "$MODEL_INFO_PATH")"
    cat >"$MODEL_INFO_PATH" <<'EOF'
{
  "updated": "1970-01-01T00:00:00+00:00",
  "_note": "Starter catalog created by 'model-gateway install'. Replace the placeholder entry by onboarding a real provider: model-gateway onboard generate --provider <id> --base-url <url> --model <model>. See docs/provider-onboarding.md.",
  "llm": [
    {
      "name": "starter-placeholder",
      "provider": "starter",
      "provider_model_id": "starter-placeholder",
      "context": 8192,
      "max_output_tokens": 4096,
      "desc": "Placeholder entry; not routable until a real provider is onboarded. Safe to delete after onboarding your first model."
    }
  ]
}
EOF
    warn "Created starter model catalog at $MODEL_INFO_PATH; onboard a real provider to route requests (see docs/provider-onboarding.md)"
  fi
  (
    cd "$ROOT_DIR"
    "$UV_BIN" run python - "$MODEL_INFO_PATH" "$CONFIG_PATH" <<'PY'
import json
import sys
from pathlib import Path

from src.catalog import load_catalog_entries

path = Path(sys.argv[1])
config_path = Path(sys.argv[2])
data = json.loads(path.read_text())
if not isinstance(data, dict) or not isinstance(data.get("llm"), list) or not data["llm"]:
    raise SystemExit("model-info.json must contain a non-empty llm list")
if any(not isinstance(row, dict) for row in data["llm"]):
    raise SystemExit("model-info.json llm entries must be objects")
effective = load_catalog_entries(path, config_path, require_nonempty=True)
if not effective:
    raise SystemExit("effective model catalog is empty")
PY
  ) || die "invalid machine-local model catalog: $MODEL_INFO_PATH"
  ok "Model catalog ready: $MODEL_INFO_PATH"
}

sync_venv() {
  log "Syncing Python environment"
  uv sync --project "$ROOT_DIR" >/dev/null
  ok "uv environment ready"
}

install_cli_symlink() {
  mkdir -p "$BIN_DIR"
  local dest="$BIN_DIR/model-gateway"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    if [ "$FORCE" = "1" ]; then
      rm -f "$dest"
    else
      warn "$dest exists and is not a symlink; leaving it untouched (use --force to replace)"
      return 0
    fi
  fi
  ln -sfn "$SCRIPT_DIR/model-gateway" "$dest"
  ok "Installed $dest → $SCRIPT_DIR/model-gateway"
}

# --------------------------------------------------------------------------- #
# Launchd plist management.
# --------------------------------------------------------------------------- #
plist_path() { printf '%s/%s.plist' "$PLIST_DIR" "$LABEL"; }

plist_working_dir() {
  local path="$1"
  [ -f "$path" ] || return 1
  if [ -x /usr/libexec/PlistBuddy ]; then
    /usr/libexec/PlistBuddy -c 'Print :WorkingDirectory' "$path" 2>/dev/null || true
  else
    awk '/<key>WorkingDirectory<\/key>/ {getline; gsub(/^[[:space:]]*<string>|<\/string>[[:space:]]*$/, ""); print; exit}' "$path" 2>/dev/null || true
  fi
}

xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

plist_env_value() {
  local path="$1" key="$2"
  [ -f "$path" ] || return 1
  /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$key" "$path" 2>/dev/null || true
}

canonical_path() {
  python3 - "$1" <<'PY'
import os, sys
print(os.path.realpath(os.path.expanduser(sys.argv[1])))
PY
}

ensure_label_safe() {
  local action="$1" plist wd
  plist="$(plist_path)"
  [ ! -e "$plist" ] && [ ! -L "$plist" ] && return 0
  [ -f "$plist" ] && [ ! -L "$plist" ] || die "Refusing unsafe LaunchAgent plist: $plist"
  wd="$(plist_working_dir "$plist")"
  if [ "$wd" = "$ROOT_DIR" ]; then
    return 0
  fi
  if [ "$FORCE" = "1" ]; then
    warn "Adopting existing $LABEL plist for $action (WorkingDirectory was: ${wd:-unknown})"
    return 0
  fi
  die "Refusing to $action $LABEL: existing plist belongs to '${wd:-unknown}', not '$ROOT_DIR'. Re-run with --force (or MODEL_GATEWAY_FORCE=1) to adopt it."
}

ensure_log_backup_separation() {
  local logs backups
  logs="$(canonical_path "$LOG_DIR")"
  backups="$(canonical_path "$BACKUP_DIR")"
  case "$backups" in "$logs"|"$logs"/*) die "private backups must remain outside diagnostic logs" ;; esac
  case "$logs" in "$backups"|"$backups"/*) die "diagnostic logs must remain outside private backups" ;; esac
}

ensure_runtime_paths_safe() {
  local action="${1:-operation}"
  ensure_label_safe "$action"
  service_loaded || die "refusing $action: launchd service is not loaded: $LABEL"
  local plist actual expected key value
  plist="$(plist_path)"
  for key in MODEL_GATEWAY_CONFIG MODEL_GATEWAY_MODEL_INFO MODEL_GATEWAY_MODEL_INFO_SOURCE; do
    case "$key" in
      MODEL_GATEWAY_CONFIG) value="$CONFIG_PATH" ;;
      MODEL_GATEWAY_MODEL_INFO) value="$MODEL_INFO_PATH" ;;
      MODEL_GATEWAY_MODEL_INFO_SOURCE) value="$MODEL_INFO_SOURCE_PATH" ;;
    esac
    [ -n "$value" ] || continue
    actual="$(plist_env_value "$plist" "$key")"
    [ -n "$actual" ] || die "refusing $action: $plist does not define $key"
    expected="$(canonical_path "$value")"
    [ "$(canonical_path "$actual")" = "$expected" ] \
      || die "refusing $action: $key targets '$actual', not '$value'"
  done
}

write_plist() {
  ensure_label_safe "overwrite"
  ensure_log_backup_separation
  ensure_private_dir "$PLIST_DIR"
  ensure_private_dir "$LOG_DIR"
  ensure_private_dir "$(dirname "$LEDGER_PATH")"
  ensure_private_dir "$BACKUP_DIR"
  ensure_private_file "$LOG_FILE"
  local plist plist_tmp e_label e_uv e_root e_host e_port e_config e_model_info e_model_info_source e_ledger e_vision_fallback e_vision_local e_vision_cloud e_vision_mode e_vision_max_images e_vision_cache_ttl e_vision_total_timeout e_log_dir e_backup e_legacy_backups e_log
  plist="$(plist_path)"
  plist_tmp="$(mktemp "$PLIST_DIR/.${LABEL}.plist.XXXXXX")"
  chmod 600 "$plist_tmp"
  e_label="$(xml_escape "$LABEL")"
  e_uv="$(xml_escape "$UV_BIN")"
  e_root="$(xml_escape "$ROOT_DIR")"
  e_host="$(xml_escape "$HOST")"
  e_port="$(xml_escape "$PORT")"
  e_config="$(xml_escape "$CONFIG_PATH")"
  e_model_info="$(xml_escape "$MODEL_INFO_PATH")"
  e_model_info_source="$(xml_escape "$MODEL_INFO_SOURCE_PATH")"
  e_ledger="$(xml_escape "$LEDGER_PATH")"
  e_vision_fallback="$(xml_escape "$VISION_FALLBACK")"
  e_vision_local="$(xml_escape "$VISION_FALLBACK_LOCAL")"
  e_vision_cloud="$(xml_escape "$VISION_FALLBACK_CLOUD")"
  e_vision_mode="$(xml_escape "$VISION_FALLBACK_MODE")"
  e_vision_max_images="$(xml_escape "$VISION_FALLBACK_MAX_IMAGES")"
  e_vision_cache_ttl="$(xml_escape "$VISION_OBSERVATION_CACHE_TTL_SECONDS")"
  e_vision_total_timeout="$(xml_escape "$VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS")"
  e_log_dir="$(xml_escape "$LOG_DIR")"
  e_backup="$(xml_escape "$BACKUP_DIR")"
  e_legacy_backups="$(xml_escape "$LEGACY_BACKUP_DIRS")"
  e_log="$(xml_escape "$LOG_FILE")"
  cat >"$plist_tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${e_label}</string>
<key>ProgramArguments</key><array>
  <string>${e_uv}</string><string>run</string><string>python</string><string>-m</string><string>src.main</string>
</array>
<key>WorkingDirectory</key><string>${e_root}</string>
<key>EnvironmentVariables</key><dict>
  <key>MODEL_GATEWAY_HOST</key><string>${e_host}</string>
  <key>MODEL_GATEWAY_PORT</key><string>${e_port}</string>
  <key>MODEL_GATEWAY_CONFIG</key><string>${e_config}</string>
  <key>MODEL_GATEWAY_MODEL_INFO</key><string>${e_model_info}</string>
  <key>MODEL_GATEWAY_MODEL_INFO_SOURCE</key><string>${e_model_info_source}</string>
  <key>MODEL_GATEWAY_LEDGER_PATH</key><string>${e_ledger}</string>
  <key>GATEWAY_VISION_FALLBACK</key><string>${e_vision_fallback}</string>
  <key>GATEWAY_VISION_FALLBACK_LOCAL</key><string>${e_vision_local}</string>
  <key>GATEWAY_VISION_FALLBACK_CLOUD</key><string>${e_vision_cloud}</string>
  <key>GATEWAY_VISION_FALLBACK_MODE</key><string>${e_vision_mode}</string>
  <key>GATEWAY_VISION_FALLBACK_MAX_IMAGES</key><string>${e_vision_max_images}</string>
  <key>GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS</key><string>${e_vision_cache_ttl}</string>
  <key>GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS</key><string>${e_vision_total_timeout}</string>
  <key>MODEL_GATEWAY_LOG_DIR</key><string>${e_log_dir}</string>
  <key>MODEL_GATEWAY_BACKUP_DIR</key><string>${e_backup}</string>
  <key>MODEL_GATEWAY_LEGACY_BACKUP_DIRS</key><string>${e_legacy_backups}</string>
</dict>
<key>StandardOutPath</key><string>${e_log}</string>
<key>StandardErrorPath</key><string>${e_log}</string>
<key>Umask</key><integer>63</integer>
<key>KeepAlive</key><true/>
<key>RunAtLoad</key><true/>
<key>ThrottleInterval</key><integer>5</integer>
</dict></plist>
EOF
  if command -v plutil >/dev/null 2>&1 && ! plutil -lint "$plist_tmp" >/dev/null; then
    rm -f "$plist_tmp"
    die "generated LaunchAgent plist is invalid"
  fi
  persist_install_config
  mv -f "$plist_tmp" "$plist"
  chmod 600 "$plist"
  ok "Wrote $plist"
}

service_target() { printf 'gui/%s/%s' "$(id -u)" "$LABEL"; }
service_loaded() { launchctl print "$(service_target)" >/dev/null 2>&1; }

bootout_service() {
  ensure_label_safe "stop"
  if service_loaded; then
    launchctl bootout "$(service_target)" >/dev/null 2>&1 || die "failed to unload launchd service: $LABEL"
  fi
  # bootout is asynchronous; poll briefly before declaring failure.
  local i=0
  while service_loaded; do
    [ $i -lt 10 ] || die "launchd service is still loaded after bootout: $LABEL"
    sleep 1; i=$((i+1))
  done
}

bootstrap_service() {
  local plist
  plist="$(plist_path)"
  [ -f "$plist" ] || die "missing plist $plist; run 'model-gateway install' first"
  ensure_label_safe "start"
  if service_loaded; then
    launchctl kickstart -k "$(service_target)" >/dev/null 2>&1 || die "failed to kickstart launchd service: $LABEL"
  else
    launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null \
      || launchctl load "$plist" 2>/dev/null \
      || die "failed to load launchd service: $LABEL"
  fi
  launchctl enable "$(service_target)" 2>/dev/null || warn "could not enable launchd service: $LABEL"
  service_loaded || die "launchd service did not load: $LABEL"
}

start_service() { bootstrap_service; }
stop_service() { bootout_service; }

_wait_port_free() { # port [timeout]
  local port="$1" t="${2:-15}" i=0
  while [ $i -lt $t ]; do
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 || return 0
    sleep 1; i=$((i+1))
  done
  lsof -nP -iTCP:"$port" -sTCP:LISTEN >&2 || true
  return 1
}

restart_service() {
  stop_service
  if ! _wait_port_free "$PORT"; then
    die "port $PORT is still bound; refusing to start a second gateway"
  fi
  start_service
}

remove_plist() {
  ensure_label_safe "remove"
  stop_service
  rm -f "$(plist_path)"
  ok "Removed $(plist_path)"
}

# --------------------------------------------------------------------------- #
# Health / verification.
# --------------------------------------------------------------------------- #
health_url() { printf 'http://127.0.0.1:%s/health' "$PORT"; }

health_ok() {
  python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)
raise SystemExit(0 if data.get("status") == "ok" and data.get("service") == "model-gateway" else 1)'
}

wait_http() { # url timeout
  local url="$1" t="${2:-30}" i=0 body
  while [ $i -lt $t ]; do
    body="$(curl -fsS --max-time 3 "$url" 2>/dev/null || true)"
    if [ -n "$body" ] && echo "$body" | health_ok; then ok "$url → model-gateway ok"; return 0; fi
    sleep 1; i=$((i+1))
  done
  warn "timeout waiting for $url"
  return 1
}

verify() { wait_http "$(health_url)" 30; }

status() {
  local state health
  state="$(launchctl print "$(service_target)" 2>/dev/null | awk -F' = ' '/^[[:space:]]*state/ {print $2; exit}' || echo 'not-loaded')"
  health="$(curl -fsS --max-time 3 "$(health_url)" 2>/dev/null || echo 'DOWN')"
  printf '%-24s %s\n' "launchd:" "${state:-unknown}"
  printf '%-24s %s\n' "health:" "$health"
  printf '%-24s %s\n' "install-config:" "$INSTALL_CONFIG"
  printf '%-24s %s\n' "config:" "$CONFIG_PATH"
  printf '%-24s %s\n' "model-info:" "$MODEL_INFO_PATH"
  printf '%-24s %s\n' "log:" "$LOG_FILE"
}

cmd_logs() {
  ensure_private_dir "$LOG_DIR"
  local arg="${1:--50}"
  case "$arg" in
    -f|--follow) tail -f "$LOG_FILE" ;;
    -*) tail "$arg" "$LOG_FILE" 2>/dev/null || warn "no log yet: $LOG_FILE" ;;
    ''|all) tail -50 "$LOG_FILE" 2>/dev/null || warn "no log yet: $LOG_FILE" ;;
    *[!0-9]*) die "usage: model-gateway logs [-f|lines]" ;;
    *) tail -"$arg" "$LOG_FILE" 2>/dev/null || warn "no log yet: $LOG_FILE" ;;
  esac
}

cmd_env() {
  cat <<EOF
ROOT_DIR=$ROOT_DIR
LABEL=$LABEL
PLIST=$(plist_path)
LOG_FILE=$LOG_FILE
BIN_DIR=$BIN_DIR
UV_BIN=$UV_BIN
MODEL_GATEWAY_HOST=$HOST
MODEL_GATEWAY_PORT=$PORT
MODEL_GATEWAY_INSTALL_CONFIG=$INSTALL_CONFIG
MODEL_GATEWAY_CONFIG=$CONFIG_PATH
MODEL_GATEWAY_MODEL_INFO=$MODEL_INFO_PATH
MODEL_GATEWAY_MODEL_INFO_SOURCE=$MODEL_INFO_SOURCE_PATH
MODEL_GATEWAY_LEDGER_PATH=$LEDGER_PATH
GATEWAY_VISION_FALLBACK=$VISION_FALLBACK
GATEWAY_VISION_FALLBACK_LOCAL=$VISION_FALLBACK_LOCAL
GATEWAY_VISION_FALLBACK_CLOUD=$VISION_FALLBACK_CLOUD
GATEWAY_VISION_FALLBACK_MODE=$VISION_FALLBACK_MODE
GATEWAY_VISION_FALLBACK_MAX_IMAGES=$VISION_FALLBACK_MAX_IMAGES
GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS=$VISION_OBSERVATION_CACHE_TTL_SECONDS
GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS=$VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS
MODEL_GATEWAY_LOG_DIR=$LOG_DIR
MODEL_GATEWAY_BACKUP_DIR=$BACKUP_DIR
MODEL_GATEWAY_LEGACY_BACKUP_DIRS=$LEGACY_BACKUP_DIRS
HEALTH_URL=$(health_url)
EOF
}

# --------------------------------------------------------------------------- #
# Subcommands.
# --------------------------------------------------------------------------- #
cmd_install() {
  local start=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-start) start=0 ;;
      --force) FORCE=1 ;;
      *) die "usage: model-gateway install [--no-start] [--force]" ;;
    esac
    shift
  done
  check_prereqs
  validate_bind_config
  log "Installing model-gateway from $ROOT_DIR"
  ensure_config
  sync_venv
  ensure_model_catalog
  install_cli_symlink
  write_plist
  if [ $start -eq 1 ]; then
    restart_service
    log "Waiting for model-gateway to come up..."
    verify || die "verification failed; check 'model-gateway logs'"
  fi
  ok "model-gateway installed"
}

cmd_uninstall() {
  log "Uninstalling model-gateway service"
  remove_plist
  local dest="$BIN_DIR/model-gateway"
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$SCRIPT_DIR/model-gateway" ]; then
    rm -f "$dest"
    ok "Removed $dest"
  fi
  ok "Uninstalled (repo and venv retained; rerun 'install' to restore)"
}

cmd_update_after_pull() {
  check_prereqs
  validate_bind_config
  sync_venv
  write_plist
  restart_service
  verify || die "verification failed after update"
  ok "model-gateway updated"
}

cmd_update() {
  check_prereqs
  log "Pulling model-gateway repo"
  git -C "$ROOT_DIR" pull --ff-only
  exec "$ROOT_DIR/bin/model-gateway" _update-after-pull
}

cmd_onboard() {
  [ $# -ge 1 ] || die "usage: model-gateway onboard PROFILE [options] | model-gateway onboard generate [options]"
  check_prereqs
  local dry_run=0 generate=0 apply=0 arg
  [ "$1" = "generate" ] && generate=1
  for arg in "$@"; do
    [ "$arg" = "--dry-run" ] && dry_run=1
    [ "$arg" = "--apply" ] && apply=1
  done
  if [ "$generate" = 0 ] && [ "$dry_run" = 0 ]; then
    ensure_runtime_paths_safe "onboarding"
  elif [ "$generate" = 1 ] && [ "$apply" = 1 ]; then
    ensure_runtime_paths_safe "onboarding"
  fi
  local cmd=("$UV_BIN" run --project "$ROOT_DIR" python "$ROOT_DIR/scripts/onboard_provider.py" "$@"
    --config "$CONFIG_PATH" --model-info "$MODEL_INFO_PATH"
    --launchd-label "$LABEL" --health-url "$(health_url)")
  if [ -n "$MODEL_INFO_SOURCE_PATH" ]; then
    cmd+=(--model-info-source "$MODEL_INFO_SOURCE_PATH")
  fi
  "${cmd[@]}"
  if [ "$generate" = 1 ] && [ "$apply" = 0 ]; then
    ok "onboarding draft generated; review it before applying"
  elif [ "$dry_run" = 0 ]; then
    ok "provider onboarding complete"
  fi
}

cmd_workspace() {
  [ $# -ge 1 ] || die "usage: model-gateway workspace {list|repair|test|add|replace|remove|normalize} [options]"
  check_prereqs
  local requested_help=0 arg
  for arg in "$@"; do
    case "$arg" in -h|--help) requested_help=1 ;; esac
  done
  case "$1" in
    list|test|normalize) ;;
    repair|add|replace|remove)
      [ "$requested_help" = 1 ] || ensure_runtime_paths_safe "workspace management"
      ;;
    -h|--help) ;;
    help) shift; set -- --help "$@" ;;
    *) die "unknown workspace command: $1" ;;
  esac
  MODEL_GATEWAY_CONFIG="$CONFIG_PATH" \
  MODEL_GATEWAY_URL="http://127.0.0.1:$PORT" \
  MODEL_GATEWAY_RESTART_BIN="$SOURCE_PATH" \
    "$UV_BIN" run --project "$ROOT_DIR" python "$ROOT_DIR/scripts/workspace.py" \
      --config "$CONFIG_PATH" "$@"
}

usage() {
  sed -n '2,/^set -euo/p' "$0" | grep -E '^#   ' | sed 's/^#   /  /'
  exit 1
}

main() {
  while [ "${1:-}" = "--force" ]; do
    FORCE=1
    shift
  done
  [ $# -ge 1 ] || usage
  case "$1" in
    install|bootstrap) shift; cmd_install "$@" ;;
    uninstall) cmd_uninstall ;;
    start) check_prereqs; start_service; verify; ok "started" ;;
    stop) stop_service; ok "stopped" ;;
    restart) check_prereqs; restart_service; verify; ok "restarted" ;;
    status) status ;;
    verify) verify ;;
    logs) shift; cmd_logs "$@" ;;
    update) cmd_update ;;
    _update-after-pull) cmd_update_after_pull ;;
    onboard) shift; cmd_onboard "$@" ;;
    workspace) shift; cmd_workspace "$@" ;;
    env) cmd_env ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $1" ;;
  esac
}

main "$@"
