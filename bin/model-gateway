#!/usr/bin/env bash
# model-gateway — portable macOS launchd operator CLI.
#
# Self-contained installer/control surface for consumer machines that run this
# repo directly (git clone + install), without the maintainer's CI-managed dev-server deployment
# infrastructure.
#
# Usage:
#   model-gateway install [--no-start] [--force]  bootstrap venv + plist + start + verify
#   model-gateway uninstall                      stop service, remove plist (keeps repo/venv)
#   model-gateway start | stop | restart
#   model-gateway status                         launchd state + /health probe
#   model-gateway verify                         /health smoke check
#   model-gateway logs [-f|lines]                tail service log
#   model-gateway update                         git pull + uv sync + restart + verify (git installs)
#   model-gateway admin                          copy the admin key and open the admin UI
#   model-gateway onboard PROFILE [options]      apply a reviewed onboarding profile
#   model-gateway onboard generate [options]     discover metadata and save a draft profile
#   model-gateway workspace COMMAND [options]    manage Databricks workspace pools
#   model-gateway secrets migrate [--dry-run]    move inline provider keys to 0600 key files
#   model-gateway consumer add|list|revoke       manage consumer credentials (0600 key files)
#   model-gateway local-ai status|add|cancel|remove  gateway-owned local AI (oMLX + a verified model)
#   model-gateway bundle export|import           move config/catalog/profiles (no secrets)
#   model-gateway env                            print resolved config
#   model-gateway version [--json]               release version (and capabilities with --json)
set -euo pipefail
umask 077

# --------------------------------------------------------------------------- #
# Config resolution.
# --------------------------------------------------------------------------- #
SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE_PATH")"
  case "$LINK_TARGET" in
    /*) SOURCE_PATH="$LINK_TARGET" ;;
    *) SOURCE_PATH="$SOURCE_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Package managers drop a .package file next to bin/ naming themselves, a
# version-independent root (so the LaunchAgent survives upgrades), the Python
# of the prebuilt runtime environment, and the upgrade command. Packaged
# installs never run uv sync or git pull.
package_value() {
  [ -f "$ROOT_DIR/.package" ] || return 0
  awk -v prefix="$1=" 'index($0, prefix) == 1 {print substr($0, length(prefix) + 1); exit}' "$ROOT_DIR/.package"
}
PACKAGE_MANAGER="$(package_value MANAGER)"
PACKAGE_UPGRADE="$(package_value UPGRADE)"
PACKAGE_UPGRADE="${PACKAGE_UPGRADE:-upgrade it with $PACKAGE_MANAGER}"
if [ -n "$PACKAGE_MANAGER" ]; then
  PACKAGE_ROOT="$(package_value ROOT)"
  [ -d "$PACKAGE_ROOT" ] || { printf 'package root is missing: %s\n' "${PACKAGE_ROOT:-unset}" >&2; exit 1; }
  ROOT_DIR="$PACKAGE_ROOT"
  SCRIPT_DIR="$ROOT_DIR/bin"
  PACKAGE_PYTHON="$(package_value PYTHON)"
  # The component package marks its LaunchAgent with its state root.
  PACKAGE_COMPONENT_ROOT="$(package_value COMPONENT_ROOT)"
fi
is_packaged() { [ -n "$PACKAGE_MANAGER" ]; }

LABEL="${MODEL_GATEWAY_LAUNCHD_LABEL:-com.local.model-gateway}"
PLIST_DIR="${MODEL_GATEWAY_PLIST_DIR:-$HOME/Library/LaunchAgents}"
LOG_DIR="${MODEL_GATEWAY_LOG_DIR:-$HOME/Library/Logs/model-gateway}"
LOG_FILE="${MODEL_GATEWAY_LOG_FILE:-$LOG_DIR/model-gateway.log}"
BACKUP_DIR="${MODEL_GATEWAY_BACKUP_DIR:-$HOME/Library/Application Support/model-gateway/backups/config}"
LEGACY_BACKUP_DIRS="${MODEL_GATEWAY_LEGACY_BACKUP_DIRS:-$LOG_DIR/config-backups}"
BIN_DIR="${MODEL_GATEWAY_BIN_DIR:-$HOME/.local/bin}"
FORCE="${MODEL_GATEWAY_FORCE:-0}"
APP_DIR="$HOME/Library/Application Support/model-gateway"
INSTALL_CONFIG="$APP_DIR/install.env"

# Machine state lives in APP_DIR. The installed LaunchAgent's paths win, and
# installs that predate APP_DIR keep using a state file at its old location.
state_path() { # current legacy
  if [ ! -e "$1" ] && [ -e "$2" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

installed_config_value() {
  local metadata
  [ -f "$INSTALL_CONFIG" ] && [ ! -L "$INSTALL_CONFIG" ] || return 0
  metadata="$(stat -f '%u %l %Lp' "$INSTALL_CONFIG" 2>/dev/null || stat -c '%u %h %a' "$INSTALL_CONFIG" 2>/dev/null || true)"
  [ "$metadata" = "$(id -u) 1 600" ] || return 0
  awk -v prefix="$1=" 'index($0, prefix) == 1 {print substr($0, length(prefix) + 1); exit}' \
    "$INSTALL_CONFIG"
}

installed_plist_env() {
  local plist="$PLIST_DIR/$LABEL.plist"
  [ -f "$plist" ] && [ ! -L "$plist" ] && [ -x /usr/libexec/PlistBuddy ] || return 0
  /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$1" "$plist" 2>/dev/null || true
}

INSTALLED_HOST="$(installed_config_value MODEL_GATEWAY_HOST)"
INSTALLED_HOST="${INSTALLED_HOST:-$(installed_plist_env MODEL_GATEWAY_HOST)}"
INSTALLED_PORT="$(installed_config_value MODEL_GATEWAY_PORT)"
INSTALLED_PORT="${INSTALLED_PORT:-$(installed_plist_env MODEL_GATEWAY_PORT)}"
HOST="${MODEL_GATEWAY_HOST:-${INSTALLED_HOST:-127.0.0.1}}"
PORT="${MODEL_GATEWAY_PORT:-${INSTALLED_PORT:-9111}}"
# Admin UI management. Fresh installs default to on (the admin API stays locked
# until an admin key is configured); an existing install that predates this
# setting keeps its read-only behavior until the operator opts in. A bare
# `python -m src.main` without this variable is read-only.
INSTALLED_ADMIN_WRITES="$(installed_config_value MODEL_GATEWAY_ADMIN_WRITES)"
INSTALLED_ADMIN_WRITES="${INSTALLED_ADMIN_WRITES:-$(installed_plist_env MODEL_GATEWAY_ADMIN_WRITES)}"
if [ -z "$INSTALLED_ADMIN_WRITES" ]; then
  if [ -e "$INSTALL_CONFIG" ] || [ -e "$PLIST_DIR/$LABEL.plist" ]; then
    INSTALLED_ADMIN_WRITES=false
  else
    INSTALLED_ADMIN_WRITES=true
  fi
fi
ADMIN_WRITES="${MODEL_GATEWAY_ADMIN_WRITES:-$INSTALLED_ADMIN_WRITES}"
INSTALLED_CONFIG_PATH="$(installed_plist_env MODEL_GATEWAY_CONFIG)"
INSTALLED_MODEL_INFO_PATH="$(installed_plist_env MODEL_GATEWAY_MODEL_INFO)"
INSTALLED_LEDGER_PATH="$(installed_plist_env MODEL_GATEWAY_LEDGER_PATH)"
CONFIG_PATH="${MODEL_GATEWAY_CONFIG:-${INSTALLED_CONFIG_PATH:-$(state_path "$APP_DIR/config.yaml" "$ROOT_DIR/config/config.yaml")}}"
MODEL_INFO_PATH="${MODEL_GATEWAY_MODEL_INFO:-${INSTALLED_MODEL_INFO_PATH:-$(state_path "$APP_DIR/model-info.json" "$ROOT_DIR/model-info.json")}}"
ACTIVE_MODEL_INFO_SOURCE=""
if [ -f "$PLIST_DIR/$LABEL.plist" ] && [ -x /usr/libexec/PlistBuddy ]; then
  ACTIVE_MODEL_INFO_SOURCE="$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:MODEL_GATEWAY_MODEL_INFO_SOURCE' "$PLIST_DIR/$LABEL.plist" 2>/dev/null || true)"
fi
MODEL_INFO_SOURCE_PATH="${MODEL_GATEWAY_MODEL_INFO_SOURCE:-${ACTIVE_MODEL_INFO_SOURCE:-$MODEL_INFO_PATH}}"
LEDGER_PATH="${MODEL_GATEWAY_LEDGER_PATH:-${INSTALLED_LEDGER_PATH:-$(state_path "$APP_DIR/ledger.db" "$HOME/srv/model-gateway/shared/ledger.db")}}"
# Legacy client keys file (e.g. imported from a Home Server gateway); kept across reinstalls.
CLIENT_KEYS_FILE="${MODEL_GATEWAY_CLIENT_KEYS_FILE-$(installed_plist_env MODEL_GATEWAY_CLIENT_KEYS_FILE)}"
if [ "${GATEWAY_VISION_FALLBACK+x}" = x ]; then
  VISION_FALLBACK="$GATEWAY_VISION_FALLBACK"
else
  VISION_FALLBACK="$(installed_plist_env GATEWAY_VISION_FALLBACK)"
fi
if [ "${GATEWAY_VISION_FALLBACK_LOCAL+x}" = x ]; then
  VISION_FALLBACK_LOCAL="$GATEWAY_VISION_FALLBACK_LOCAL"
else
  VISION_FALLBACK_LOCAL="$(installed_plist_env GATEWAY_VISION_FALLBACK_LOCAL)"
fi
if [ "${GATEWAY_VISION_FALLBACK_CLOUD+x}" = x ]; then
  VISION_FALLBACK_CLOUD="$GATEWAY_VISION_FALLBACK_CLOUD"
else
  VISION_FALLBACK_CLOUD="$(installed_plist_env GATEWAY_VISION_FALLBACK_CLOUD)"
fi
if [ "${GATEWAY_VISION_FALLBACK_MODE+x}" = x ]; then
  VISION_FALLBACK_MODE="$GATEWAY_VISION_FALLBACK_MODE"
else
  VISION_FALLBACK_MODE="$(installed_plist_env GATEWAY_VISION_FALLBACK_MODE)"
fi
if [ "${GATEWAY_VISION_FALLBACK_MAX_IMAGES+x}" = x ]; then
  VISION_FALLBACK_MAX_IMAGES="$GATEWAY_VISION_FALLBACK_MAX_IMAGES"
else
  VISION_FALLBACK_MAX_IMAGES="$(installed_plist_env GATEWAY_VISION_FALLBACK_MAX_IMAGES)"
fi
if [ "${GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS+x}" = x ]; then
  VISION_OBSERVATION_CACHE_TTL_SECONDS="$GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS"
else
  VISION_OBSERVATION_CACHE_TTL_SECONDS="$(installed_plist_env GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS)"
fi
if [ "${GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS+x}" = x ]; then
  VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS="$GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS"
else
  VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS="$(installed_plist_env GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS)"
fi
UV_BIN="${UV_BIN:-$(command -v uv 2>/dev/null || true)}"

# Colors (disabled when not a TTY).
if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'
else
  C_RESET=""; C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""
fi

log()  { printf '%s▶%s %s\n' "$C_BOLD" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

require_cmd() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1 (install it and retry)"; }

ensure_private_dir() {
  local path="$1"
  [ ! -L "$path" ] || die "refusing symlinked private directory: $path"
  mkdir -p "$path"
  [ -d "$path" ] && [ ! -L "$path" ] || die "private path is not a directory: $path"
  [ "$(stat -f '%u' "$path")" = "$(id -u)" ] || die "private directory is not owned by this user: $path"
  chmod 700 "$path"
}

ensure_private_file() {
  local path="$1" metadata
  if [ -e "$path" ] || [ -L "$path" ]; then
    [ -f "$path" ] && [ ! -L "$path" ] || die "refusing unsafe private file: $path"
    metadata="$(stat -f '%u %l' "$path")"
    [ "$metadata" = "$(id -u) 1" ] || die "private file has unsafe ownership or hard links: $path"
  else
    : > "$path"
  fi
  chmod 600 "$path"
}

validate_bind_config() {
  case "$HOST" in ''|*[[:space:]]*) die "MODEL_GATEWAY_HOST must be a nonempty host without whitespace" ;; esac
  case "$PORT" in ''|*[!0-9]*) die "MODEL_GATEWAY_PORT must be an integer between 1 and 65535" ;; esac
  if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    die "MODEL_GATEWAY_PORT must be an integer between 1 and 65535"
  fi
  case "$ADMIN_WRITES" in true|false) ;; *) die "MODEL_GATEWAY_ADMIN_WRITES must be true or false" ;; esac
}

persist_install_config() {
  validate_bind_config
  ensure_private_dir "$(dirname "$INSTALL_CONFIG")"
  local tmp metadata
  if [ -e "$INSTALL_CONFIG" ] || [ -L "$INSTALL_CONFIG" ]; then
    [ -f "$INSTALL_CONFIG" ] && [ ! -L "$INSTALL_CONFIG" ] \
      || die "refusing unsafe private file: $INSTALL_CONFIG"
    metadata="$(stat -f '%u %l' "$INSTALL_CONFIG" 2>/dev/null || stat -c '%u %h' "$INSTALL_CONFIG")"
    [ "$metadata" = "$(id -u) 1" ] \
      || die "private file has unsafe ownership or hard links: $INSTALL_CONFIG"
  fi
  tmp="$(mktemp "$(dirname "$INSTALL_CONFIG")/.install.env.XXXXXX")"
  chmod 600 "$tmp"
  printf 'MODEL_GATEWAY_HOST=%s\nMODEL_GATEWAY_PORT=%s\nMODEL_GATEWAY_ADMIN_WRITES=%s\n' \
    "$HOST" "$PORT" "$ADMIN_WRITES" >"$tmp"
  mv -f "$tmp" "$INSTALL_CONFIG"
  chmod 600 "$INSTALL_CONFIG"
}

check_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "model-gateway installer currently supports macOS launchd only"
}

check_prereqs() {
  check_macos
  require_cmd curl
  require_cmd python3
  require_cmd launchctl
  if is_packaged; then
    [ -x "$PACKAGE_PYTHON" ] || die "packaged Python environment is missing: ${PACKAGE_PYTHON:-unset} (reinstall model-gateway)"
    return 0
  fi
  require_cmd git
  require_cmd uv
  UV_BIN="${UV_BIN:-$(command -v uv)}"
  [ -n "$UV_BIN" ] || die "uv not found"
}

# Run the gateway's Python: the packaged venv, or uv's project environment.
run_python() {
  if is_packaged; then
    "$PACKAGE_PYTHON" "$@"
  else
    "$UV_BIN" run --project "$ROOT_DIR" python "$@"
  fi
}

# --------------------------------------------------------------------------- #
# Bootstrap.
# --------------------------------------------------------------------------- #
ensure_config() {
  if [ -f "$CONFIG_PATH" ]; then
    log "Config exists: $CONFIG_PATH"
    local real_config mode
    real_config="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$CONFIG_PATH")"
    mode="$(stat -f '%Lp' "$real_config" 2>/dev/null || stat -c '%a' "$real_config" 2>/dev/null || echo '')"
    if [ -n "$mode" ] && [ "$mode" != "600" ]; then
      chmod 600 "$real_config"
      warn "Tightened config permissions to 0600 (was $mode): $real_config"
    fi
    return 0
  fi
  mkdir -p "$(dirname "$CONFIG_PATH")"
  ( umask 077; : >"$CONFIG_PATH" )
  local admin_key
  admin_key="mg-admin-$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
  cat >"$CONFIG_PATH" <<EOF
# model-gateway runtime config.
# Created by bin/model-gateway install. See config/config.yaml.example for the
# full provider/auth/export template. Reference provider keys with a mode-0600
# api_key_file (the admin UI and onboarding write them); this file is gitignored
# and should never be committed.

auth:
  # admin_keys protects /admin/api/* and the admin UI. Generated at install;
  # 'model-gateway admin' copies it and opens the UI.
  admin_keys:
    - ${admin_key}
  # client_keys protects /v1/*. Leave empty only when MODEL_GATEWAY_HOST is
  # loopback/private; add keys for any externally reachable gateway.
  client_keys: []

providers: {}

# Downstream alias catalog consumed by pi-shared/bin/pi-catalog. The gateway
# re-renders it at startup and on reload; consumers find this path in
# ~/Library/Application Support/model-gateway/endpoint.json.
exports:
  model_aliases: ~/Library/Application Support/model-gateway/model-aliases.json
EOF
  chmod 600 "$CONFIG_PATH"
  warn "Created config at $CONFIG_PATH; run 'model-gateway admin' to add providers in the admin UI"
}

ensure_model_catalog() {
  if [ ! -f "$MODEL_INFO_PATH" ]; then
    # Fresh install: an explicitly empty catalog lets the gateway start before
    # the first model is registered in the admin UI or with 'onboard'.
    mkdir -p "$(dirname "$MODEL_INFO_PATH")"
    cat >"$MODEL_INFO_PATH" <<'EOF'
{
  "updated": "1970-01-01T00:00:00+00:00",
  "_note": "Model catalog created by 'model-gateway install'. Register models in the admin UI ('model-gateway admin') or with 'model-gateway onboard'. allow_empty lets the gateway start with no models.",
  "allow_empty": true,
  "llm": []
}
EOF
    warn "Created an empty model catalog at $MODEL_INFO_PATH; register models in the admin UI ('model-gateway admin')"
  fi
  (
    cd "$ROOT_DIR"
    run_python - "$MODEL_INFO_PATH" "$CONFIG_PATH" <<'PY'
import json
import os
import sys
from pathlib import Path

from src.catalog import load_catalog_entries

path = Path(sys.argv[1])
config_path = Path(sys.argv[2])
data = json.loads(path.read_text())
if not isinstance(data, dict) or not isinstance(data.get("llm"), list):
    raise SystemExit("model-info.json must contain an llm list")
if any(not isinstance(row, dict) for row in data["llm"]):
    raise SystemExit("model-info.json llm entries must be objects")
# Installers before 0.2.1 seeded an unroutable placeholder; replace a catalog
# that still holds only that entry with the explicitly empty catalog. Write
# through symlinks under the config lock, like every other catalog writer.
if [(row.get("name"), row.get("provider")) for row in data["llm"]] == [("starter-placeholder", "starter")]:
    from src.config_lock import config_write_lock

    with config_write_lock(config_path):
        target = path.resolve()
        data = json.loads(target.read_text())
        if [(row.get("name"), row.get("provider")) for row in data["llm"]] == [("starter-placeholder", "starter")]:
            data["llm"] = []
            data["allow_empty"] = True
            data.pop("_note", None)
            tmp = target.with_name(f".{target.name}.tmp.{os.getpid()}")
            tmp.write_text(json.dumps(data, indent=2) + "\n")
            os.chmod(tmp, target.stat().st_mode & 0o777)
            os.replace(tmp, target)
            print("Removed the starter placeholder from the model catalog")
load_catalog_entries(path, config_path, require_nonempty=True)
PY
  ) || die "invalid machine-local model catalog: $MODEL_INFO_PATH"
  ok "Model catalog ready: $MODEL_INFO_PATH"
}

sync_venv() {
  is_packaged && return 0
  log "Syncing Python environment"
  uv sync --project "$ROOT_DIR" >/dev/null
  ok "uv environment ready"
}

install_cli_symlink() {
  is_packaged && return 0
  mkdir -p "$BIN_DIR"
  local dest="$BIN_DIR/model-gateway"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    if [ "$FORCE" = "1" ]; then
      rm -f "$dest"
    else
      warn "$dest exists and is not a symlink; leaving it untouched (use --force to replace)"
      return 0
    fi
  fi
  ln -sfn "$SCRIPT_DIR/model-gateway" "$dest"
  ok "Installed $dest → $SCRIPT_DIR/model-gateway"
}

# --------------------------------------------------------------------------- #
# Launchd plist management.
# --------------------------------------------------------------------------- #
plist_path() { printf '%s/%s.plist' "$PLIST_DIR" "$LABEL"; }

plist_working_dir() {
  local path="$1"
  [ -f "$path" ] || return 1
  if [ -x /usr/libexec/PlistBuddy ]; then
    /usr/libexec/PlistBuddy -c 'Print :WorkingDirectory' "$path" 2>/dev/null || true
  else
    awk '/<key>WorkingDirectory<\/key>/ {getline; gsub(/^[[:space:]]*<string>|<\/string>[[:space:]]*$/, ""); print; exit}' "$path" 2>/dev/null || true
  fi
}

xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

plist_env_value() {
  local path="$1" key="$2"
  [ -f "$path" ] || return 1
  /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$key" "$path" 2>/dev/null || true
}

canonical_path() {
  python3 - "$1" <<'PY'
import os, sys
print(os.path.realpath(os.path.expanduser(sys.argv[1])))
PY
}

ensure_label_safe() {
  local action="$1" plist wd
  plist="$(plist_path)"
  [ ! -e "$plist" ] && [ ! -L "$plist" ] && return 0
  [ -f "$plist" ] && [ ! -L "$plist" ] || die "Refusing unsafe LaunchAgent plist: $plist"
  wd="$(plist_working_dir "$plist")"
  if [ "$wd" = "$ROOT_DIR" ]; then
    return 0
  fi
  if [ "$FORCE" = "1" ]; then
    warn "Adopting existing $LABEL plist for $action (WorkingDirectory was: ${wd:-unknown})"
    return 0
  fi
  die "Refusing to $action $LABEL: existing plist belongs to '${wd:-unknown}', not '$ROOT_DIR'. Re-run with --force (or MODEL_GATEWAY_FORCE=1) to adopt it."
}

ensure_log_backup_separation() {
  local logs backups
  logs="$(canonical_path "$LOG_DIR")"
  backups="$(canonical_path "$BACKUP_DIR")"
  case "$backups" in "$logs"|"$logs"/*) die "private backups must remain outside diagnostic logs" ;; esac
  case "$logs" in "$backups"|"$backups"/*) die "diagnostic logs must remain outside private backups" ;; esac
}

ensure_runtime_paths_safe() {
  local action="${1:-operation}" allow_unloaded="${2:-}"
  ensure_label_safe "$action"
  if [ "$allow_unloaded" = allow-unloaded ]; then
    [ -f "$(plist_path)" ] || die "refusing $action: missing LaunchAgent plist: $(plist_path)"
  else
    service_loaded || die "refusing $action: launchd service is not loaded: $LABEL"
  fi
  local plist actual expected key value
  plist="$(plist_path)"
  for key in MODEL_GATEWAY_CONFIG MODEL_GATEWAY_MODEL_INFO MODEL_GATEWAY_MODEL_INFO_SOURCE; do
    case "$key" in
      MODEL_GATEWAY_CONFIG) value="$CONFIG_PATH" ;;
      MODEL_GATEWAY_MODEL_INFO) value="$MODEL_INFO_PATH" ;;
      MODEL_GATEWAY_MODEL_INFO_SOURCE) value="$MODEL_INFO_SOURCE_PATH" ;;
    esac
    [ -n "$value" ] || continue
    actual="$(plist_env_value "$plist" "$key")"
    [ -n "$actual" ] || die "refusing $action: $plist does not define $key"
    expected="$(canonical_path "$value")"
    [ "$(canonical_path "$actual")" = "$expected" ] \
      || die "refusing $action: $key targets '$actual', not '$value'"
  done
}

write_plist() {
  ensure_label_safe "overwrite"
  ensure_log_backup_separation
  ensure_private_dir "$PLIST_DIR"
  ensure_private_dir "$LOG_DIR"
  ensure_private_dir "$(dirname "$LEDGER_PATH")"
  ensure_private_dir "$BACKUP_DIR"
  ensure_private_file "$LOG_FILE"
  local plist plist_tmp program_args owner_key="" client_keys="" e_label e_plist_dir e_root e_host e_port e_admin_writes e_config e_model_info e_model_info_source e_ledger e_vision_fallback e_vision_local e_vision_cloud e_vision_mode e_vision_max_images e_vision_cache_ttl e_vision_total_timeout e_log_dir e_backup e_legacy_backups e_log
  plist="$(plist_path)"
  plist_tmp="$(mktemp "$PLIST_DIR/.${LABEL}.plist.XXXXXX")"
  chmod 600 "$plist_tmp"
  e_label="$(xml_escape "$LABEL")"
  e_plist_dir="$(xml_escape "$PLIST_DIR")"
  if is_packaged; then
    program_args="<string>$(xml_escape "$PACKAGE_PYTHON")</string>"
  else
    program_args="<string>$(xml_escape "$UV_BIN")</string><string>run</string><string>python</string>"
  fi
  program_args="$program_args<string>-m</string><string>src.main</string>"
  if [ -n "${PACKAGE_COMPONENT_ROOT:-}" ]; then
    owner_key="<key>ModelGatewayComponentRoot</key><string>$(xml_escape "$PACKAGE_COMPONENT_ROOT")</string>"
  fi
  if [ -n "$CLIENT_KEYS_FILE" ]; then
    client_keys="
  <key>MODEL_GATEWAY_CLIENT_KEYS_FILE</key><string>$(xml_escape "$CLIENT_KEYS_FILE")</string>"
  fi
  e_root="$(xml_escape "$ROOT_DIR")"
  e_host="$(xml_escape "$HOST")"
  e_port="$(xml_escape "$PORT")"
  e_admin_writes="$(xml_escape "$ADMIN_WRITES")"
  e_config="$(xml_escape "$CONFIG_PATH")"
  e_model_info="$(xml_escape "$MODEL_INFO_PATH")"
  e_model_info_source="$(xml_escape "$MODEL_INFO_SOURCE_PATH")"
  e_ledger="$(xml_escape "$LEDGER_PATH")"
  e_vision_fallback="$(xml_escape "$VISION_FALLBACK")"
  e_vision_local="$(xml_escape "$VISION_FALLBACK_LOCAL")"
  e_vision_cloud="$(xml_escape "$VISION_FALLBACK_CLOUD")"
  e_vision_mode="$(xml_escape "$VISION_FALLBACK_MODE")"
  e_vision_max_images="$(xml_escape "$VISION_FALLBACK_MAX_IMAGES")"
  e_vision_cache_ttl="$(xml_escape "$VISION_OBSERVATION_CACHE_TTL_SECONDS")"
  e_vision_total_timeout="$(xml_escape "$VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS")"
  e_log_dir="$(xml_escape "$LOG_DIR")"
  e_backup="$(xml_escape "$BACKUP_DIR")"
  e_legacy_backups="$(xml_escape "$LEGACY_BACKUP_DIRS")"
  e_log="$(xml_escape "$LOG_FILE")"
  cat >"$plist_tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${e_label}</string>${owner_key}
<key>ProgramArguments</key><array>
  ${program_args}
</array>
<key>WorkingDirectory</key><string>${e_root}</string>
<key>EnvironmentVariables</key><dict>
  <key>MODEL_GATEWAY_LAUNCHD_LABEL</key><string>${e_label}</string>
  <key>MODEL_GATEWAY_PLIST_DIR</key><string>${e_plist_dir}</string>
  <key>MODEL_GATEWAY_HOST</key><string>${e_host}</string>
  <key>MODEL_GATEWAY_PORT</key><string>${e_port}</string>
  <key>MODEL_GATEWAY_ADMIN_WRITES</key><string>${e_admin_writes}</string>
  <key>MODEL_GATEWAY_CONFIG</key><string>${e_config}</string>
  <key>MODEL_GATEWAY_MODEL_INFO</key><string>${e_model_info}</string>
  <key>MODEL_GATEWAY_MODEL_INFO_SOURCE</key><string>${e_model_info_source}</string>
  <key>MODEL_GATEWAY_LEDGER_PATH</key><string>${e_ledger}</string>${client_keys}
  <key>GATEWAY_VISION_FALLBACK</key><string>${e_vision_fallback}</string>
  <key>GATEWAY_VISION_FALLBACK_LOCAL</key><string>${e_vision_local}</string>
  <key>GATEWAY_VISION_FALLBACK_CLOUD</key><string>${e_vision_cloud}</string>
  <key>GATEWAY_VISION_FALLBACK_MODE</key><string>${e_vision_mode}</string>
  <key>GATEWAY_VISION_FALLBACK_MAX_IMAGES</key><string>${e_vision_max_images}</string>
  <key>GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS</key><string>${e_vision_cache_ttl}</string>
  <key>GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS</key><string>${e_vision_total_timeout}</string>
  <key>MODEL_GATEWAY_LOG_DIR</key><string>${e_log_dir}</string>
  <key>MODEL_GATEWAY_BACKUP_DIR</key><string>${e_backup}</string>
  <key>MODEL_GATEWAY_LEGACY_BACKUP_DIRS</key><string>${e_legacy_backups}</string>
</dict>
<key>StandardOutPath</key><string>${e_log}</string>
<key>StandardErrorPath</key><string>${e_log}</string>
<key>Umask</key><integer>63</integer>
<key>KeepAlive</key><true/>
<key>RunAtLoad</key><true/>
<key>ThrottleInterval</key><integer>5</integer>
</dict></plist>
EOF
  if command -v plutil >/dev/null 2>&1 && ! plutil -lint "$plist_tmp" >/dev/null; then
    rm -f "$plist_tmp"
    die "generated LaunchAgent plist is invalid"
  fi
  persist_install_config
  mv -f "$plist_tmp" "$plist"
  chmod 600 "$plist"
  ok "Wrote $plist"
}

service_target() { printf 'gui/%s/%s' "$(id -u)" "$LABEL"; }
service_loaded() { launchctl print "$(service_target)" >/dev/null 2>&1; }

bootout_service() {
  ensure_label_safe "stop"
  if service_loaded; then
    launchctl bootout "$(service_target)" >/dev/null 2>&1 || die "failed to unload launchd service: $LABEL"
  fi
  # bootout is asynchronous; poll briefly before declaring failure.
  local i=0
  while service_loaded; do
    [ $i -lt 10 ] || die "launchd service is still loaded after bootout: $LABEL"
    sleep 1; i=$((i+1))
  done
}

bootstrap_service() {
  local plist
  plist="$(plist_path)"
  [ -f "$plist" ] || die "missing plist $plist; run 'model-gateway install' first"
  ensure_label_safe "start"
  if service_loaded; then
    launchctl kickstart -k "$(service_target)" >/dev/null 2>&1 || die "failed to kickstart launchd service: $LABEL"
  else
    launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null \
      || launchctl load "$plist" 2>/dev/null \
      || die "failed to load launchd service: $LABEL"
  fi
  launchctl enable "$(service_target)" 2>/dev/null || warn "could not enable launchd service: $LABEL"
  service_loaded || die "launchd service did not load: $LABEL"
}

start_service() { bootstrap_service; }
stop_service() { bootout_service; }

_wait_port_free() { # port [timeout]
  local port="$1" t="${2:-15}" i=0
  while [ $i -lt $t ]; do
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 || return 0
    sleep 1; i=$((i+1))
  done
  lsof -nP -iTCP:"$port" -sTCP:LISTEN >&2 || true
  return 1
}

restart_service() {
  stop_service
  if ! _wait_port_free "$PORT"; then
    die "port $PORT is still bound; refusing to start a second gateway"
  fi
  start_service
}

remove_plist() {
  ensure_label_safe "remove"
  stop_service
  rm -f "$(plist_path)"
  ok "Removed $(plist_path)"
}

# --------------------------------------------------------------------------- #
# Health / verification.
# --------------------------------------------------------------------------- #
health_url() { printf 'http://127.0.0.1:%s/health' "$PORT"; }

health_ok() {
  python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)
raise SystemExit(0 if data.get("status") == "ok" and data.get("service") == "model-gateway" else 1)'
}

wait_http() { # url timeout
  local url="$1" t="${2:-30}" i=0 body
  while [ $i -lt $t ]; do
    body="$(curl -fsS --max-time 3 "$url" 2>/dev/null || true)"
    if [ -n "$body" ] && echo "$body" | health_ok; then ok "$url → model-gateway ok"; return 0; fi
    sleep 1; i=$((i+1))
  done
  warn "timeout waiting for $url"
  return 1
}

verify() { wait_http "$(health_url)" 30; }

status() {
  local state health
  state="$(launchctl print "$(service_target)" 2>/dev/null | awk -F' = ' '/^[[:space:]]*state/ {print $2; exit}' || echo 'not-loaded')"
  health="$(curl -fsS --max-time 3 "$(health_url)" 2>/dev/null || echo 'DOWN')"
  printf '%-24s %s\n' "launchd:" "${state:-unknown}"
  printf '%-24s %s\n' "health:" "$health"
  printf '%-24s %s\n' "install-config:" "$INSTALL_CONFIG"
  printf '%-24s %s\n' "config:" "$CONFIG_PATH"
  printf '%-24s %s\n' "model-info:" "$MODEL_INFO_PATH"
  printf '%-24s %s\n' "log:" "$LOG_FILE"
}

cmd_logs() {
  ensure_private_dir "$LOG_DIR"
  local arg="${1:--50}"
  case "$arg" in
    -f|--follow) tail -f "$LOG_FILE" ;;
    -*) tail "$arg" "$LOG_FILE" 2>/dev/null || warn "no log yet: $LOG_FILE" ;;
    ''|all) tail -50 "$LOG_FILE" 2>/dev/null || warn "no log yet: $LOG_FILE" ;;
    *[!0-9]*) die "usage: model-gateway logs [-f|lines]" ;;
    *) tail -"$arg" "$LOG_FILE" 2>/dev/null || warn "no log yet: $LOG_FILE" ;;
  esac
}

cmd_version() {
  case "${1:-}" in
    "") sed -n 's/^VERSION = "\(.*\)"$/\1/p' "$ROOT_DIR/src/version.py" ;;
    --json)
      # No service or project environment needed: works while the gateway is stopped.
      /usr/bin/python3 - "$ROOT_DIR/src/version.py" <<'PY'
import ast, json, sys
values = {node.targets[0].id: ast.literal_eval(node.value)
          for node in ast.parse(open(sys.argv[1]).read()).body
          if isinstance(node, ast.Assign) and len(node.targets) == 1}
print(json.dumps({"service": "model-gateway", "version": values["VERSION"],
                  "capabilities": list(values["CAPABILITIES"])}))
PY
      ;;
    *) die "usage: model-gateway version [--json]" ;;
  esac
}

cmd_env() {
  cat <<EOF
ROOT_DIR=$ROOT_DIR
PACKAGE_MANAGER=${PACKAGE_MANAGER:-git}
LABEL=$LABEL
PLIST=$(plist_path)
LOG_FILE=$LOG_FILE
BIN_DIR=$BIN_DIR
UV_BIN=$UV_BIN
MODEL_GATEWAY_HOST=$HOST
MODEL_GATEWAY_PORT=$PORT
MODEL_GATEWAY_ADMIN_WRITES=$ADMIN_WRITES
MODEL_GATEWAY_INSTALL_CONFIG=$INSTALL_CONFIG
MODEL_GATEWAY_CONFIG=$CONFIG_PATH
MODEL_GATEWAY_MODEL_INFO=$MODEL_INFO_PATH
MODEL_GATEWAY_MODEL_INFO_SOURCE=$MODEL_INFO_SOURCE_PATH
MODEL_GATEWAY_LEDGER_PATH=$LEDGER_PATH
GATEWAY_VISION_FALLBACK=$VISION_FALLBACK
GATEWAY_VISION_FALLBACK_LOCAL=$VISION_FALLBACK_LOCAL
GATEWAY_VISION_FALLBACK_CLOUD=$VISION_FALLBACK_CLOUD
GATEWAY_VISION_FALLBACK_MODE=$VISION_FALLBACK_MODE
GATEWAY_VISION_FALLBACK_MAX_IMAGES=$VISION_FALLBACK_MAX_IMAGES
GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS=$VISION_OBSERVATION_CACHE_TTL_SECONDS
GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS=$VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS
MODEL_GATEWAY_LOG_DIR=$LOG_DIR
MODEL_GATEWAY_BACKUP_DIR=$BACKUP_DIR
MODEL_GATEWAY_LEGACY_BACKUP_DIRS=$LEGACY_BACKUP_DIRS
MODEL_GATEWAY_ENDPOINT_FILE=${MODEL_GATEWAY_ENDPOINT_FILE-$HOME/Library/Application Support/model-gateway/endpoint.json}
HEALTH_URL=$(health_url)
EOF
}

# --------------------------------------------------------------------------- #
# Subcommands.
# --------------------------------------------------------------------------- #
cmd_install() {
  local start=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-start) start=0 ;;
      --force) FORCE=1 ;;
      *) die "usage: model-gateway install [--no-start] [--force]" ;;
    esac
    shift
  done
  check_prereqs
  validate_bind_config
  # Refuse another checkout's or package's LaunchAgent before creating any state.
  ensure_label_safe "install"
  log "Installing model-gateway from $ROOT_DIR"
  ensure_config
  sync_venv
  ensure_model_catalog
  install_cli_symlink
  write_plist
  if [ $start -eq 1 ]; then
    restart_service
    log "Waiting for model-gateway to come up..."
    verify || die "verification failed; check 'model-gateway logs'"
  fi
  ok "model-gateway installed"
  log "Next: run 'model-gateway admin' to open the admin UI and connect a provider"
}

# Local AI runs as its own LaunchAgent, so uninstalling the gateway leaves it running.
warn_local_ai_installed() {
  local omlx="$PLIST_DIR/com.local.omlx.plist" state="${MODEL_GATEWAY_STATE_DIR:-$APP_DIR}" owner
  [ -f "$omlx" ] && [ ! -L "$omlx" ] && [ -x /usr/libexec/PlistBuddy ] || return 0
  owner="$(/usr/libexec/PlistBuddy -c 'Print :ModelGatewayRoot' "$omlx" 2>/dev/null || true)"
  [ "$owner" = "$state#$LABEL" ] || return 0
  warn "this gateway's local AI (com.local.omlx, with its model in $state/local-ai) is still installed and running"
  warn "remove it and its model with: model-gateway local-ai remove"
}

cmd_uninstall() {
  log "Uninstalling model-gateway service"
  remove_plist
  local dest="$BIN_DIR/model-gateway"
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$SCRIPT_DIR/model-gateway" ]; then
    rm -f "$dest"
    ok "Removed $dest"
  fi
  if is_packaged; then
    ok "Uninstalled the service (state in $APP_DIR retained); remove the package with your package manager"
  else
    ok "Uninstalled (repo and venv retained; rerun 'install' to restore)"
  fi
  warn_local_ai_installed
}

cmd_update_after_pull() {
  check_prereqs
  validate_bind_config
  sync_venv
  write_plist
  restart_service
  verify || die "verification failed after update"
  ok "model-gateway updated"
}

cmd_update() {
  if is_packaged; then
    die "installed with $PACKAGE_MANAGER; update with: $PACKAGE_UPGRADE && model-gateway restart"
  fi
  check_prereqs
  log "Pulling model-gateway repo"
  git -C "$ROOT_DIR" pull --ff-only
  exec "$ROOT_DIR/bin/model-gateway" _update-after-pull
}

# Package managers call this after installing or upgrading the package to
# build the locked runtime environment named by .package.
cmd_sync_packaged_env() {
  is_packaged || die "_sync-packaged-env is only for package-manager installs"
  local uv base_python
  uv="$(package_value UV)"
  base_python="$(package_value BASE_PYTHON)"
  [ -x "$uv" ] && [ -x "$base_python" ] && [ -n "$PACKAGE_PYTHON" ] \
    || die "invalid package metadata: $ROOT_DIR/.package"
  UV_PROJECT_ENVIRONMENT="$(dirname "$(dirname "$PACKAGE_PYTHON")")" \
  UV_PYTHON_DOWNLOADS=never UV_NO_CONFIG=1 \
    "$uv" sync --project "$ROOT_DIR" --frozen --no-dev --no-install-project --no-cache --python "$base_python"
}

cmd_admin() {
  check_prereqs
  local key url="http://127.0.0.1:$PORT/admin"
  key="$(installed_plist_env MODEL_GATEWAY_ADMIN_KEY | cut -d, -f1)"
  if [ -z "$key" ]; then
    key="$(cd "$ROOT_DIR" && MODEL_GATEWAY_ADMIN_KEY='' MODEL_GATEWAY_CONFIG="$CONFIG_PATH" \
      run_python -c 'from src.auth import _admin_keys; print(min(_admin_keys(), default=""))' 2>/dev/null)" \
      || die "could not read admin keys from $CONFIG_PATH"
  fi
  [ -n "$key" ] || die "no admin key configured; add one under auth.admin_keys in $CONFIG_PATH"
  if printf '%s' "$key" | pbcopy 2>/dev/null; then
    ok "Admin key copied to the clipboard; paste it into the admin UI to unlock"
  else
    warn "Clipboard unavailable; paste this admin key into the admin UI to unlock:"
    printf '%s\n' "$key"
  fi
  open "$url" 2>/dev/null || log "Open $url"
}

cmd_onboard() {
  [ $# -ge 1 ] || die "usage: model-gateway onboard PROFILE [options] | model-gateway onboard generate [options]"
  check_prereqs
  local dry_run=0 generate=0 apply=0 arg
  [ "$1" = "generate" ] && generate=1
  for arg in "$@"; do
    [ "$arg" = "--dry-run" ] && dry_run=1
    [ "$arg" = "--apply" ] && apply=1
  done
  if [ "$generate" = 0 ] && [ "$dry_run" = 0 ]; then
    ensure_runtime_paths_safe "onboarding"
  elif [ "$generate" = 1 ] && [ "$apply" = 1 ]; then
    ensure_runtime_paths_safe "onboarding"
  fi
  local cmd=(run_python "$ROOT_DIR/scripts/onboard_provider.py" "$@"
    --config "$CONFIG_PATH" --model-info "$MODEL_INFO_PATH"
    --launchd-label "$LABEL" --health-url "$(health_url)")
  if [ -n "$MODEL_INFO_SOURCE_PATH" ]; then
    cmd+=(--model-info-source "$MODEL_INFO_SOURCE_PATH")
  fi
  # Post-reload /v1 verification must authenticate like the running service;
  # an operator-exported key (e.g. a consumer token) still wins.
  MODEL_GATEWAY_CLIENT_KEYS="${MODEL_GATEWAY_CLIENT_KEYS:-$(installed_plist_env MODEL_GATEWAY_CLIENT_KEYS)}" \
  MODEL_GATEWAY_CLIENT_KEYS_FILE="$(installed_plist_env MODEL_GATEWAY_CLIENT_KEYS_FILE)" \
    "${cmd[@]}"
  if [ "$generate" = 1 ] && [ "$apply" = 0 ]; then
    ok "onboarding draft generated; review it before applying"
  elif [ "$dry_run" = 0 ]; then
    ok "provider onboarding complete"
  fi
}

cmd_secrets() {
  [ "${1:-}" = "migrate" ] || die "usage: model-gateway secrets migrate [--dry-run]"
  shift
  local dry_run=0 arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run=1 ;;
      *) die "unknown secrets migrate option: $arg" ;;
    esac
  done
  check_prereqs
  [ "$dry_run" = 1 ] || ensure_runtime_paths_safe "secret migration"
  # Keep the pre-migration config backup with the running service's backups.
  local rc=0 backup_dir
  backup_dir="$(plist_env_value "$(plist_path)" MODEL_GATEWAY_BACKUP_DIR || true)"
  MODEL_GATEWAY_BACKUP_DIR="${backup_dir:-$BACKUP_DIR}" \
  MODEL_GATEWAY_MODEL_INFO="$MODEL_INFO_PATH" \
  MODEL_GATEWAY_MODEL_INFO_SOURCE="$MODEL_INFO_SOURCE_PATH" \
    run_python "$ROOT_DIR/scripts/migrate_api_keys.py" \
      --config "$CONFIG_PATH" "$@" || rc=$?
  # Exit 3: nothing to move, so the running gateway needs no restart.
  [ "$rc" = 3 ] && return 0
  [ "$rc" = 0 ] || die "secret migration failed (exit $rc)"
  if [ "$dry_run" = 0 ]; then
    restart_service
    verify
    ok "provider keys migrated; gateway restarted"
  fi
}

# Run a Python operator helper with the running service's environment, so
# validation sees the same client keys, backup dir, and vision policy.
run_service_python() {
  local script="$1" backup_dir
  shift
  backup_dir="$(installed_plist_env MODEL_GATEWAY_BACKUP_DIR)"
  MODEL_GATEWAY_BACKUP_DIR="${backup_dir:-$BACKUP_DIR}" \
  MODEL_GATEWAY_CLIENT_KEYS="$(installed_plist_env MODEL_GATEWAY_CLIENT_KEYS)" \
  MODEL_GATEWAY_CLIENT_KEYS_FILE="$(installed_plist_env MODEL_GATEWAY_CLIENT_KEYS_FILE)" \
  MODEL_GATEWAY_ADMIN_KEY="$(installed_plist_env MODEL_GATEWAY_ADMIN_KEY)" \
  MODEL_GATEWAY_PROFILE_REGISTRY="$(installed_plist_env MODEL_GATEWAY_PROFILE_REGISTRY)" \
  MODEL_GATEWAY_MODEL_INFO="$MODEL_INFO_PATH" \
  MODEL_GATEWAY_MODEL_INFO_SOURCE="$MODEL_INFO_SOURCE_PATH" \
  GATEWAY_VISION_FALLBACK="$VISION_FALLBACK" \
  GATEWAY_VISION_FALLBACK_LOCAL="$VISION_FALLBACK_LOCAL" \
  GATEWAY_VISION_FALLBACK_CLOUD="$VISION_FALLBACK_CLOUD" \
  GATEWAY_VISION_FALLBACK_MODE="$VISION_FALLBACK_MODE" \
  GATEWAY_VISION_FALLBACK_MAX_IMAGES="$VISION_FALLBACK_MAX_IMAGES" \
  GATEWAY_VISION_OBSERVATION_CACHE_TTL_SECONDS="$VISION_OBSERVATION_CACHE_TTL_SECONDS" \
  GATEWAY_VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS="$VISION_EXTRACTION_TOTAL_TIMEOUT_SECONDS" \
    run_python "$ROOT_DIR/scripts/$script" --config "$CONFIG_PATH" "$@"
}

cmd_consumer() {
  local usage="usage: model-gateway consumer {add CONSUMER --role runtime|deployer|manager [--namespace NS] [--allow-direct-models] [--provider ID] [--local-ai] | list [--json] | revoke CREDENTIAL_ID}"
  [ $# -ge 1 ] || die "$usage"
  local mutate=0 arg rc=0
  case "$1" in
    list) ;;
    add|revoke) mutate=1 ;;
    -h|--help|help) shift; set -- --help ;;
    *) die "$usage" ;;
  esac
  for arg in "$@"; do
    case "$arg" in -h|--help) mutate=0 ;; esac
  done
  check_prereqs
  [ "$mutate" = 0 ] || ensure_runtime_paths_safe "consumer management"
  run_service_python consumers.py "$@" || rc=$?
  # Exit 3: nothing changed, so the running gateway needs no restart.
  [ "$rc" = 3 ] && return 0
  [ "$rc" = 0 ] || exit "$rc"
  if [ "$mutate" = 1 ]; then
    restart_service
    verify || die "gateway did not come back after the consumer change; check 'model-gateway logs'"
    ok "consumer credentials updated; gateway restarted"
  fi
}

# Run src.local_runtime against this gateway's resolved paths and service.
# The setup job it launches re-enters through _local-ai-job with the same values.
# MODEL_GATEWAY_PACKAGE_ROOT is ROOT_DIR unresolved (a package's `current`), so
# the job follows an upgrade instead of pinning the release Python imported from.
run_local_ai() {
  local backup_dir uv="$UV_BIN"
  backup_dir="$(installed_plist_env MODEL_GATEWAY_BACKUP_DIR)"
  is_packaged && uv="$(package_value UV)"
  (
    cd "$ROOT_DIR"
    MODEL_GATEWAY_CONFIG="$CONFIG_PATH" \
    MODEL_GATEWAY_MODEL_INFO="$MODEL_INFO_PATH" \
    MODEL_GATEWAY_MODEL_INFO_SOURCE="$MODEL_INFO_SOURCE_PATH" \
    MODEL_GATEWAY_BACKUP_DIR="${MODEL_GATEWAY_BACKUP_DIR:-${backup_dir:-$BACKUP_DIR}}" \
    MODEL_GATEWAY_STATE_DIR="${MODEL_GATEWAY_STATE_DIR:-$APP_DIR}" \
    MODEL_GATEWAY_HOST="$HOST" MODEL_GATEWAY_PORT="$PORT" \
    MODEL_GATEWAY_LAUNCHD_LABEL="$LABEL" MODEL_GATEWAY_PLIST_DIR="$PLIST_DIR" \
    MODEL_GATEWAY_UV_BIN="${MODEL_GATEWAY_UV_BIN:-$uv}" \
    MODEL_GATEWAY_PACKAGE_ROOT="$ROOT_DIR" \
      run_python -m src.local_runtime "$@"
  )
}

cmd_local_ai() {
  local usage="usage: model-gateway local-ai {status [--json] | add [MODEL] | cancel | remove}"
  [ $# -ge 1 ] || die "$usage"
  case "$1" in
    status|cancel) ;;
    # The setup job restarts the gateway, so it must be this checkout's loaded service.
    add) check_prereqs; ensure_runtime_paths_safe "local AI setup" ;;
    # Also works after 'uninstall', when there is no gateway LaunchAgent to check or restart.
    remove)
      check_prereqs
      if [ -e "$(plist_path)" ] || [ -L "$(plist_path)" ]; then
        ensure_runtime_paths_safe "local AI removal" allow-unloaded
      fi
      ;;
    -h|--help|help) printf '%s\n' "$usage"; return 0 ;;
    *) die "$usage" ;;
  esac
  check_macos
  is_packaged || UV_BIN="${UV_BIN:-$(command -v uv 2>/dev/null || true)}"
  is_packaged || [ -n "$UV_BIN" ] || die "required command not found: uv (install it and retry)"
  local rc=0
  run_local_ai "$@" || rc=$?
  [ "$rc" = 0 ] || exit "$rc"
}

# EXIT/INT/TERM trap for the whole import: any failure, die, or interrupt
# restores the pre-import files once the helper has saved them, and restarts
# the gateway only if it was already restarted on the imported files.
BUNDLE_ROLLBACK=""
BUNDLE_RESTARTED=0
bundle_restore_on_exit() {
  local rc=$?
  trap - EXIT INT TERM
  [ "$rc" != 0 ] || rc=1
  if [ -s "$BUNDLE_ROLLBACK" ]; then
    warn "bundle import did not complete; restoring the previous files"
    if run_service_python bundle.py restore-rollback "$BUNDLE_ROLLBACK"; then
      if [ "$BUNDLE_RESTARTED" = 1 ]; then
        ( restart_service && verify ) || warn "gateway still unhealthy after restoring; check 'model-gateway logs'"
      fi
    else
      warn "restore failed; previous files are saved in $BUNDLE_ROLLBACK"
      warn "recover with: model-gateway bundle restore-rollback $BUNDLE_ROLLBACK"
    fi
  else
    # The helper saves nothing before refusing a bundle, so nothing changed.
    rm -f "$BUNDLE_ROLLBACK"
  fi
  exit "$rc"
}

cmd_bundle() {
  local usage="usage: model-gateway bundle {export [--out FILE] | import FILE [--force] [--dry-run] | restore-rollback FILE}"
  [ $# -ge 1 ] || die "$usage"
  local mutate=0 arg rc=0 backup_dir
  case "$1" in
    export) ;;
    import|restore-rollback) mutate=1 ;;
    -h|--help|help) shift; set -- --help ;;
    *) die "$usage" ;;
  esac
  for arg in "$@"; do
    case "$arg" in -h|--help|--dry-run) mutate=0 ;; esac
  done
  check_prereqs
  if [ "$mutate" = 0 ]; then
    run_service_python bundle.py "$@" || rc=$?
    # Exit 3: dry run, nothing written.
    [ "$rc" = 3 ] && return 0
    [ "$rc" = 0 ] && return 0
    exit "$rc"
  fi
  if [ "$1" = restore-rollback ]; then
    # Recovery must work after a failed bootstrap left the service unloaded.
    ensure_runtime_paths_safe "bundle restore" allow-unloaded
    run_service_python bundle.py "$@"
    restart_service
    verify || die "gateway unhealthy after restoring; check 'model-gateway logs'"
    ok "previous gateway files restored; gateway restarted"
    return 0
  fi
  ensure_runtime_paths_safe "bundle import"
  # Keep the pre-import contents with the private config backups so a
  # gateway that will not start on the imported files can be restored.
  backup_dir="$(installed_plist_env MODEL_GATEWAY_BACKUP_DIR)"
  backup_dir="${backup_dir:-$BACKUP_DIR}"
  ensure_private_dir "$backup_dir"
  BUNDLE_ROLLBACK="$(mktemp "$backup_dir/bundle-rollback.XXXXXX")"
  BUNDLE_RESTARTED=0
  trap bundle_restore_on_exit EXIT INT TERM
  run_service_python bundle.py "$@" --rollback-file "$BUNDLE_ROLLBACK" || exit $?
  BUNDLE_RESTARTED=1
  restart_service
  verify || die "gateway did not start on the imported bundle"
  trap - EXIT INT TERM
  rm -f "$BUNDLE_ROLLBACK"
  ok "bundle imported; gateway restarted"
}

cmd_workspace() {
  [ $# -ge 1 ] || die "usage: model-gateway workspace {list|repair|test|add|replace|remove|pool|normalize} [options]"
  check_prereqs
  local requested_help=0 arg
  for arg in "$@"; do
    case "$arg" in -h|--help) requested_help=1 ;; esac
  done
  case "$1" in
    list|test|normalize) ;;
    repair|add|replace|remove|pool)
      [ "$requested_help" = 1 ] || ensure_runtime_paths_safe "workspace management"
      ;;
    -h|--help) ;;
    help) shift; set -- --help "$@" ;;
    *) die "unknown workspace command: $1" ;;
  esac
  MODEL_GATEWAY_CONFIG="$CONFIG_PATH" \
  MODEL_GATEWAY_URL="http://127.0.0.1:$PORT" \
  MODEL_GATEWAY_RESTART_BIN="$SOURCE_PATH" \
    run_python "$ROOT_DIR/scripts/workspace.py" \
      --config "$CONFIG_PATH" "$@"
}

usage() {
  sed -n '2,/^set -euo/p' "$0" | grep -E '^#   ' | sed 's/^#   /  /'
  exit 1
}

main() {
  while [ "${1:-}" = "--force" ]; do
    FORCE=1
    shift
  done
  [ $# -ge 1 ] || usage
  case "$1" in
    install|bootstrap) shift; cmd_install "$@" ;;
    uninstall) cmd_uninstall ;;
    start) check_prereqs; start_service; verify; ok "started" ;;
    stop) stop_service; ok "stopped" ;;
    restart) check_prereqs; restart_service; verify; ok "restarted" ;;
    status) status ;;
    verify) verify ;;
    logs) shift; cmd_logs "$@" ;;
    update) cmd_update ;;
    admin) cmd_admin ;;
    _update-after-pull) cmd_update_after_pull ;;
    _sync-packaged-env) cmd_sync_packaged_env ;;
    onboard) shift; cmd_onboard "$@" ;;
    workspace) shift; cmd_workspace "$@" ;;
    secrets) shift; cmd_secrets "$@" ;;
    consumer) shift; cmd_consumer "$@" ;;
    local-ai) shift; cmd_local_ai "$@" ;;
    _local-ai-job) shift; check_macos; run_local_ai job "$@" ;;
    bundle) shift; cmd_bundle "$@" ;;
    env) cmd_env ;;
    version) shift; cmd_version "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $1" ;;
  esac
}

main "$@"
