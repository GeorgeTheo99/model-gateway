# Model gateway provider configuration.
# Copy to config.yaml and fill in API keys.
# This file is symlinked to shared/ on the server (contains secrets).

# Inbound auth for the gateway itself. Both fields are optional.
#   admin_keys  -> protects /admin/api/* (fail-closed until at least one is set)
#   client_keys -> protects /v1/* (leave empty to keep /v1 open)
# Each field accepts a list of keys or a single comma-separated string.
# Env vars MODEL_GATEWAY_ADMIN_KEY / MODEL_GATEWAY_CLIENT_KEYS override these.
auth:
  admin_keys:
    - "admin"
  # client_keys:
  #   - "cloud"

providers:
  # Providers are optional and local-runtime only. model-info.json may list
  # models for many providers, but /v1/models exposes only models whose provider
  # is configured and enabled here (or via env). Missing providers do not block
  # startup; requests for those models return provider_not_configured.
  # Set enabled: false to keep a provider configured but unavailable locally.

  fireworks:
    base_url: https://api.fireworks.ai/inference/v1
    api_key: "YOUR_FIREWORKS_API_KEY"
  zhipuai:
    base_url: https://open.bigmodel.cn/api/paas/v4
    api_key: "YOUR_ZHIPUAI_API_KEY"

  zai_coding:
    base_url: https://api.z.ai/api/coding/paas/v4
    api_key: "YOUR_ZAI_CODING_API_KEY"

  anthropic:
    base_url: https://api.anthropic.com/v1
    api_key: "YOUR_ANTHROPIC_API_KEY"
    protocol: anthropic

  openai:
    base_url: https://api.openai.com/v1
    api_key: "YOUR_OPENAI_API_KEY"

  # Optional Databricks Model Serving / Foundation Model APIs. Leave disabled
  # or omit entirely on machines that should not use Databricks. You can also
  # configure it with env only:
  #   DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
  #   DATABRICKS_TOKEN=...
  #   # optional explicit OpenAI-compatible base URL override:
  #   DATABRICKS_SERVING_BASE_URL=https://your-workspace.cloud.databricks.com/serving-endpoints
  databricks:
    enabled: false
    base_url: https://your-workspace.cloud.databricks.com/serving-endpoints
    api_key: "YOUR_DATABRICKS_TOKEN"
    protocol: openai

  # ── Advanced provider keys (all optional, all runtime-local) ───────────────
  # Everything provider- or workspace-specific stays in this file — the repo
  # never hardcodes hostnames, endpoint names, or model lists. A generic
  # "my_workspace" example for an AI-gateway / model-serving style provider:
  #
  # my_workspace:
  #   base_url: https://your-workspace.example.com
  #   api_key: "YOUR_TOKEN_OR_OAUTH_JWT"
  #   protocol: openai            # provider default; models may override below
  #
  #   # endpoint_style: invocations
  #   #   Each model gets its own complete invocation URL:
  #   #     <base_url>/serving-endpoints/<provider_model_id>/invocations
  #   #   (endpoint_suffix becomes "" — no /chat/completions is appended).
  #   endpoint_style: invocations
  #
  #   # path_prefixes: per-protocol path appended to base_url (mutually
  #   # exclusive with endpoint_style in practice). Lets one host serve both
  #   # Anthropic- and OpenAI-protocol models under different base paths.
  #   path_prefixes:
  #     anthropic: /gateway/anthropic/v1
  #     openai: /gateway/openai/v1
  #
  #   # quirks: generic upstream compatibility flags (config, not code):
  #   #   no_stream_options   -> upstream 400s on OpenAI stream_options; drop it
  #   #   no_reasoning_params -> upstream rejects reasoning_effort/thinking;
  #   #                          never inject or forward reasoning controls
  #   quirks:
  #     - no_stream_options
  #     - no_reasoning_params
  #
  #   # auth_refresh: opt-in OAuth token auto-refresh. The gateway refreshes
  #   # short-lived OAuth JWTs before expiry and retries once after upstream
  #   # 401/403. PATs and opaque API keys are left untouched.
  #   # Only "databricks-cli" is supported (uses `databricks auth token`).
  #   auth_refresh: databricks-cli
  #   auth_profile: my-cli-profile   # optional; falls back to --host <base_url>

# Runtime-local model overlay. Same schema as model-info.json `llm` entries;
# merged on top of the committed catalog (overlay wins on id clash). Keeps
# machine/workspace-specific model routes out of the repo entirely.
# Per-model `protocol` overrides the provider default (useful when one
# gateway host serves both Anthropic- and OpenAI-protocol models).
# models:
#   - name: my-hosted-model
#     alias: mhm
#     provider: my_workspace
#     provider_model_id: my-serving-endpoint-name
#     protocol: anthropic
#     context: 200000
#     max_output_tokens: 64000
#     thinking: optional
#     pricing: {input: 3.0, output: 15.0}

# Config-driven model fallback: after a retryable upstream failure
# (429/502/503/504, or 404 "model not found"), retry once with the mapped
# model. Keys/values are upstream provider model ids (as sent in the request
# body). Never hardcoded in the repo — workspace-specific pairs live here.
# model_fallbacks:
#   my-primary-endpoint: my-fallback-endpoint

# Optional downstream catalog exports (omit entirely on machines without Pi).
# Regenerated on gateway start and /admin/api/reload; drift-checked via
# scripts/export_catalogs.py --check.
# exports:
#   pi_models: ~/local_code/pi-local/config/pi-models/models.json
#   pi_launchers: ~/local_code/model-gateway-runtime/pi-launchers.zsh
