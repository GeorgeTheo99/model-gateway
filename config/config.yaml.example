# Model gateway provider configuration.
# Copy to config.yaml and fill in API keys.
# This file is symlinked to shared/ on the server (contains secrets).

# Inbound auth for the gateway itself. Both fields are optional.
#   admin_keys  -> protects /admin/api/* (fail-closed until at least one is set)
#   client_keys -> protects /v1/* (leave empty to keep /v1 open)
# Each field accepts a list of keys or a single comma-separated string.
# Env vars MODEL_GATEWAY_ADMIN_KEY / MODEL_GATEWAY_CLIENT_KEYS override these.
auth:
  admin_keys:
    - "YOUR_MODEL_GATEWAY_ADMIN_KEY"
  # client_keys:
  #   - "cloud"

providers:
  # Providers are optional and local-runtime only. model-info.json may list
  # models for many providers, but /v1/models exposes only models whose provider
  # is configured and enabled here (or via env). Missing providers do not block
  # startup; requests for those models return provider_not_configured.
  # Set enabled: false to keep a provider configured but unavailable locally.

  fireworks:
    base_url: https://api.fireworks.ai/inference/v1
    api_key: "YOUR_FIREWORKS_API_KEY"
  zhipuai:
    base_url: https://open.bigmodel.cn/api/paas/v4
    api_key: "YOUR_ZHIPUAI_API_KEY"

  zai_coding:
    base_url: https://api.z.ai/api/coding/paas/v4
    api_key: "YOUR_ZAI_CODING_API_KEY"

  anthropic:
    base_url: https://api.anthropic.com/v1
    api_key: "YOUR_ANTHROPIC_API_KEY"
    protocol: anthropic

  openai:
    base_url: https://api.openai.com/v1
    api_key: "YOUR_OPENAI_API_KEY"

  # Optional Databricks Model Serving / Foundation Model APIs. Leave disabled
  # or omit entirely on machines that should not use Databricks. You can also
  # configure it with env only:
  #   DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
  #   DATABRICKS_TOKEN=...
  #   # optional explicit OpenAI-compatible base URL override:
  #   DATABRICKS_SERVING_BASE_URL=https://your-workspace.cloud.databricks.com/serving-endpoints
  databricks:
    enabled: false
    base_url: https://your-workspace.cloud.databricks.com/serving-endpoints
    api_key: "YOUR_DATABRICKS_TOKEN"
    protocol: openai
